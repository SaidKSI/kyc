// KYC Verification Platform — Database Schema
// Visualize at https://dbdiagram.io

// ─────────────────────────────────────────────
// OPERATORS (business accounts)
// ─────────────────────────────────────────────

Table operators {
  id              varchar(36)  [pk]
  name            text         [not null]
  email           text         [unique, not null]
  password_hash   text         [not null]
  plan            text         [not null, default: 'free', note: 'free | pro | enterprise']
  status          text         [not null, default: 'active', note: 'active | suspended']
  webhook_url     text
  webhook_secret  text
  created_at      timestamptz  [not null, default: `now()`]
  deleted_at      timestamptz  [note: 'soft delete']

  indexes {
    email
    status
  }
}

// ─────────────────────────────────────────────
// API KEYS (multiple per operator)
// ─────────────────────────────────────────────

Table api_keys {
  id              varchar(36)  [pk]
  operator_id     varchar(36)  [not null, ref: > operators.id]
  name            text         [not null, note: 'e.g. Production, Staging']
  key_hash        text         [unique, not null]
  environment     text         [not null, default: 'production', note: 'sandbox | production']
  last_used_at    timestamptz
  expires_at      timestamptz  [note: 'NULL = never expires']
  created_at      timestamptz  [not null, default: `now()`]
  revoked_at      timestamptz  [note: 'NULL = active']

  indexes {
    key_hash
    operator_id
    revoked_at
  }
}

// ─────────────────────────────────────────────
// OPERATOR SETTINGS (per-operator overrides)
// ─────────────────────────────────────────────

Table operator_settings {
  operator_id           varchar(36)  [pk, ref: - operators.id]
  allowed_doc_types     text[]       [note: 'NULL = all types allowed']
  require_liveness      boolean      [not null, default: true]
  retention_days        int          [not null, default: 90]
  allowed_origins       text[]       [note: 'CORS whitelist, NULL = use global']
  score_approve_threshold int        [note: 'NULL = use global (75)']
  score_reject_threshold  int        [note: 'NULL = use global (35)']
  updated_at            timestamptz  [not null, default: `now()`]
}

// ─────────────────────────────────────────────
// VERIFICATIONS (one per KYC session)
// ─────────────────────────────────────────────

Table verifications {
  id                  varchar(36)  [pk, note: 'ver_<hex16>']
  operator_id         varchar(36)  [not null, ref: > operators.id]
  reference_id        text         [not null, note: 'operator internal user ID']
  document_type       text         [not null, note: 'national_id | passport | residence_permit | drivers_license']
  status              text         [not null, default: 'pending', note: 'pending | processing | approved | rejected | review | error']

  // Session token — used by the end-user browser (never the API key)
  session_token       text         [unique, note: 'ses_<random>, short-lived frontend token']
  session_expires_at  timestamptz

  // Result
  score               int
  decision            text         [note: 'approved | rejected | review']
  checks              jsonb        [note: 'raw output from each ML step']
  extracted_fields    jsonb        [note: 'structured OCR output, PII encrypted at rest']

  // Storage keys
  doc_front_key       text
  doc_back_key        text
  selfie_key          text

  // Context
  locale              text         [default: 'en']
  redirect_url        text         [note: 'where to send user after completion']
  ip_address          text
  user_agent          text
  attempt_number      int          [not null, default: 1]
  metadata            jsonb        [note: 'arbitrary operator key-values']

  // Timestamps
  created_at          timestamptz  [not null, default: `now()`]
  completed_at        timestamptz
  purge_at            timestamptz  [note: 'computed from operator retention_days']

  indexes {
    operator_id
    status
    session_token
    reference_id
    created_at
    purge_at
  }
}

// ─────────────────────────────────────────────
// AUDIT EVENTS (append-only log)
// ─────────────────────────────────────────────

Table audit_events {
  id               varchar(36)  [pk]
  verification_id  varchar(36)  [ref: > verifications.id]
  event_type       text         [not null, note: 'submitted | check_complete | decision | webhook_sent | manual_override']
  actor            text         [not null, note: 'system | operator:<id> | agent:<id>']
  payload          jsonb
  created_at       timestamptz  [not null, default: `now()`]

  indexes {
    verification_id
    event_type
    created_at
  }
}

// ─────────────────────────────────────────────
// WEBHOOK DELIVERIES (outbound log + retry)
// ─────────────────────────────────────────────

Table webhook_deliveries {
  id               varchar(36)  [pk]
  verification_id  varchar(36)  [not null, ref: > verifications.id]
  operator_id      varchar(36)  [not null, ref: > operators.id]
  url              text         [not null]
  payload          jsonb        [not null]
  status_code      int          [note: 'NULL = not yet attempted']
  attempt          int          [not null, default: 1]
  next_retry_at    timestamptz
  delivered_at     timestamptz
  created_at       timestamptz  [not null, default: `now()`]

  indexes {
    verification_id
    operator_id
    next_retry_at
    delivered_at
  }
}

// ─────────────────────────────────────────────
// DASHBOARD SESSIONS (JWT refresh store)
// ─────────────────────────────────────────────

Table dashboard_sessions {
  id           varchar(36)  [pk]
  operator_id  varchar(36)  [not null, ref: > operators.id]
  token_hash   text         [unique, not null]
  ip_address   text
  user_agent   text
  expires_at   timestamptz  [not null]
  created_at   timestamptz  [not null, default: `now()`]
  revoked_at   timestamptz

  indexes {
    token_hash
    operator_id
    expires_at
  }
}
