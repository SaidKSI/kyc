# ── API ───────────────────────────────────────────────────────────────────────
# FastAPI backend URL — must match FRONTEND_ORIGIN set in backend/.env
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Dev origins ───────────────────────────────────────────────────────────────
# Comma-separated extra allowed dev origins (e.g. ngrok tunnel for mobile testing)
# Matches next.config.ts allowedDevOrigins — leave empty in production
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=
