# Copy to backend/.env.production and fill in values

DATABASE_URL=postgresql+asyncpg://kyc:POSTGRES_PASSWORD@db:5432/kyc_platform
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=r2
UPLOAD_DIR=/kyc-uploads

# Cloudflare R2
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=kyc-documents
R2_REGION=auto

# Auth — generate strong random values
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
API_KEY_SALT=change-me-in-production
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-in-production

WEBHOOK_TIMEOUT_SECONDS=10

SCORE_APPROVE_THRESHOLD=75
SCORE_REJECT_THRESHOLD=35

DOCUMENT_RETENTION_DAYS=90

# Must match your actual frontend domain
FRONTEND_ORIGIN=https://yourdomain.com

ENVIRONMENT=production

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
