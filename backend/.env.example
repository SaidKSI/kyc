# PostgreSQL via Laragon
# Laragon default: user=root, no password
# Create DB first: Laragon → HeidiSQL → create 'kyc_platform'
DATABASE_URL=postgresql+asyncpg://postgres:@localhost:5432/kyc

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage backend: local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=C:/kyc-uploads

# S3 (ignored when STORAGE_BACKEND=local)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kyc-documents
S3_REGION=eu-west-1

# Auth — change both in production
JWT_SECRET=change-me-in-production
API_KEY_SALT=change-me-in-production

# Webhook
WEBHOOK_TIMEOUT_SECONDS=10

# Risk score thresholds
SCORE_APPROVE_THRESHOLD=75
SCORE_REJECT_THRESHOLD=35

# Document retention (days)
DOCUMENT_RETENTION_DAYS=90

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:3000
