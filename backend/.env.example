# ── Database ─────────────────────────────────────────────────────────────────
# Laragon default: user=root, no password
# Create DB first: Laragon → HeidiSQL → create 'kyc_platform'
DATABASE_URL=postgresql+asyncpg://root:@localhost:5432/kyc_platform

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=C:/kyc-uploads

# S3 vars (ignored when STORAGE_BACKEND=local)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kyc-documents
S3_REGION=eu-west-1

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change all three in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
API_KEY_SALT=change-me-in-production

# Fernet key for PII encryption at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-in-production

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10

# ── Risk score thresholds ─────────────────────────────────────────────────────
SCORE_APPROVE_THRESHOLD=75
SCORE_REJECT_THRESHOLD=35

# ── Retention ────────────────────────────────────────────────────────────────
DOCUMENT_RETENTION_DAYS=90

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Used for OCR field extraction and fraud analysis
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Environment ───────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
